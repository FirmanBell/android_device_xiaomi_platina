# CNE
persist.vendor.cne.feature=1

# Dex2oat
dalvik.vm.dex2oat-cpu-set=4,5,6,7
dalvik.vm.dex2oat-threads=4
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.image-dex2oat-cpu-set=4,5,6,7
dalvik.vm.image-dex2oat-threads=4

# DPM
persist.vendor.dpm.feature=11

# Filesystem
fs_mgr.overlayfs.prefer_cache_backing_storage=true

# Netflix
ro.netflix.bsp_rev=Q660-13149-1

# Radio
DEVICE_PROVISIONED=1
persist.sys.fflag.override.settings_network_and_internet_v2=true
ril.subscription.types=NV,RUIM
telephony.lteOnCdmaDevice=1

# Disable Skia tracing by default
debug.hwui.skia_atrace_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

# Zygote Preforking
persist.device_config.runtime_native.usap_pool_enabled=true

# Infinity-X
ro.product.marketname=MI 8 Lite
ro.infinity.soc=Snapdragon 660
ro.infinity.battery=3350 mAh
ro.infinity.display=6.26″, 60Hz, 2280x1080
ro.infinity.camera=24MP + 12MP + 5MP

# Dexopt
pm.dexopt.install=speed-profile
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.ab-ota=verify
pm.dexopt.boot-after-ota=verify
pm.dexopt.first-boot=verify
